# Secrets — never commit real credentials or captured cookies.
.env

# Bootstrap scratch (answers file the setup-vexa skill writes)
bootstrap.json

# Virtual environment
.venv/

# Test artifacts
reports/
logs/
*.log

# Playwright / evidence scratch
.playwright-mcp/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# IDE — shared .vscode configs (launch/settings/mcp/extensions) ARE committed;
# ignore only editor-local scratch. .idea stays out.
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/mcp.json
!.vscode/extensions.json
