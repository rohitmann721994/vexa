# Vexa test-automation framework — environment configuration.
# Copy this file to `.env` and fill in your app's values. `.env` is gitignored;
# never commit real credentials.

# --- UI target -------------------------------------------------------------
# Base URL of the app under test. If unset, the example UI test skips cleanly.
UI_BASE_URL=https://your-app.example.com

# Login credentials for your test account.
QA_USERNAME=your_test_user
QA_PASSWORD=your_test_password

# Browser engine for UI runs: chromium | firefox | webkit  (default: chromium)
# JURY_BROWSER kept as a familiar name; VEXA_BROWSER also honored.
VEXA_BROWSER=chromium

# --- Login form selectors (override if your app differs) -------------------
# Defaults match a classic single-form login (username + password + submit).
LOGIN_USERNAME_SELECTOR=#UserName
LOGIN_PASSWORD_SELECTOR=#Password
LOGIN_SUBMIT_SELECTOR=input[type=submit]
# Optional: a selector that is only present AFTER a successful login. When set,
# the example test asserts it appears; leave blank to skip that assertion.
LOGIN_SUCCESS_SELECTOR=

# --- API target ------------------------------------------------------------
# Base URL for JSON endpoints (used by ApiLibrary). Often the UI origin + /api.
API_BASE_URL=https://your-app.example.com/api
# Auto-populated by ApiLibrary after a browser login; leave blank initially.
# Also reused as-is by the k6/ performance module (see
# docs/performance-testing-guide.md) — export both values into the shell
# before `k6 run`, k6 does not read .env files directly.
API_COOKIES=

# --- Tracker attachment upload (utils/jira_attach.py, optional) ------------
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_BASE_URL=https://your-org.atlassian.net
